# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local dev: test phone numbers for OTP without real SMS ---
#
# Supabase allows you to configure test phone numbers that accept a fixed OTP
# without sending a real SMS. Set these in:
#   Supabase dashboard → Authentication → Phone → Test phone numbers
#
# Example:
#   Phone: +15005550001  OTP: 123456
#   Phone: +15005550002  OTP: 123456
#
# Then use those numbers locally. No SMS is sent and no Twilio/SMS provider
# is needed for development.
#
# IMPORTANT for production: configure OTP rate limiting in
#   Supabase dashboard → Authentication → Rate limits
# Recommended minimums:
#   - OTP requests per hour per phone: 3
#   - Failed verify attempts before lockout: 5
