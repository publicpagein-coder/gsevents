# PostgreSQL — use ?connection_limit=10&pool_timeout=20 for Prisma connection pooling
DATABASE_URL="postgresql://user:password@localhost:5432/gsevents?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (change to a long random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# MSG91 (OTP provider)
# If not set, the server runs in mock mode and always accepts OTP "123456"
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-msg91-template-id"

# Cloudinary (image uploads — Stage 2)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Server
PORT=4000
NODE_ENV=development

# Web frontend origin (used for CORS in production)
WEB_URL="https://your-web-domain.com"
